# =============================================================================
# Alethix（探赜）· 环境变量模板
# =============================================================================
# 使用方式：
#     cp .env.example .env
# 然后按注释修改。.env 已被 .gitignore 忽略，本文件仅作为模板提交到仓库。
#
# 本文件同时被两处读取：
#   1. docker compose —— 用于 ${VAR} 插值，决定容器端口、账号、密码
#   2. 应用服务      —— 由 pydantic-settings 加载，决定连接串与智能体参数
# =============================================================================


# -----------------------------------------------------------------------------
# 一、PostgreSQL（docker compose 使用）
# -----------------------------------------------------------------------------
POSTGRES_USER=alethix
POSTGRES_PASSWORD=alethix_dev_password
POSTGRES_DB=alethix
POSTGRES_PORT=5432

# ⚠️ 若修改了上面三项，已有的 postgres_data 卷不会自动变更（initdb 仅在卷为空时执行）。
#    需要执行：docker compose down -v && docker compose up -d


# -----------------------------------------------------------------------------
# 二、Redis（docker compose 使用）
# -----------------------------------------------------------------------------
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# 三、Qdrant（docker compose 使用端口，应用使用 URL 与 Collection）
# -----------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# 可选：INFO / DEBUG / TRACE。DEBUG 会显著增加日志量，仅排查问题时使用
QDRANT_LOG_LEVEL=INFO

# 应用侧连接地址。应用跑在宿主机，所以用 localhost 而非容器服务名
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
# 本地开发不启用鉴权，留空即可；若填写，需同步在 docker-compose.yml 中
# 取消 QDRANT__SERVICE__API_KEY 那一行的注释
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# 四、应用侧连接串
# -----------------------------------------------------------------------------
# 注意密码需与上面的 POSTGRES_PASSWORD 保持一致
POSTGRES_DSN=postgresql+asyncpg://alethix:alethix_dev_password@localhost:5432/alethix
POSTGRES_POOL_SIZE=20

REDIS_URL=redis://localhost:6379/0

# 上传的原始文件存放位置（local 模式下为本地目录，已被 .gitignore 忽略）
STORAGE_BACKEND=local
STORAGE_PATH=./data/files


# -----------------------------------------------------------------------------
# 五、LLM 与 Embedding
# -----------------------------------------------------------------------------
# 通过 OpenAI 兼容接口接入，可切换 vLLM / DeepSeek / Qwen 等端点。
#
# 【端点与密钥的优先级】
#   LLM 与 Embedding 各有独立的 *_BASE_URL / *_API_KEY。
#   专用变量【留空】时，自动回退到下面的通用变量 OPENAI_BASE_URL / OPENAI_API_KEY：
#
#       实际生效值 = 专用变量 or 通用变量
#
#   这样设计的原因是：LLM 与 Embedding 常常来自【不同】的服务。
#   例如用本地 TEI 做 Embedding、用 OpenAI 做大模型时，若只改通用的
#   OPENAI_BASE_URL，大模型地址会被一起改掉，导致 chat 调用失败
#   （TEI 只有 /v1/embeddings，没有 /v1/chat/completions）。
#   正确做法是【只】设置 EMBEDDING_BASE_URL，LLM_BASE_URL 保持留空。

# ---- 通用兜底值（专用变量留空时生效）----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- LLM 专用（留空则回退到上面的通用值）----
LLM_BASE_URL=
LLM_API_KEY=

LLM_MODEL=gpt-4o-mini
# 结构化输出解析失败时使用的降级模型，留空表示与主模型相同
LLM_FALLBACK_MODEL=
# 决策类节点建议使用 0，保证判断稳定可复现
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Embedding 专用（留空则回退到上面的通用值）----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
# 必须与所用模型的维度严格一致；应用层启动时会校验，不一致直接拒绝启动
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64


# -----------------------------------------------------------------------------
# 六、智能体与检索参数
# -----------------------------------------------------------------------------
# MVP 建议 3，生产建议 5
AGENT_MAX_ITERATIONS=3
AGENT_MAX_QUERIES_PER_ROUND=3
AGENT_TOP_K_PER_QUERY=10
# 低于该分数判定为 low_relevance，直接回答「未找到足够证据」
AGENT_SCORE_THRESHOLD=0.35
# 上下文预算：控制每轮送入 LLM 的证据规模，防止 Token 膨胀
AGENT_MAX_EVIDENCE_PER_ROUND=12
AGENT_MAX_CHUNK_CHARS=1500
AGENT_TOKEN_BUDGET=60000
AGENT_TIMEOUT_SECONDS=120
# 连续多少轮无新增证据即停止调研
AGENT_NO_NEW_EVIDENCE_ROUNDS=1


# -----------------------------------------------------------------------------
# 七、文档处理
# -----------------------------------------------------------------------------
DOC_MAX_FILE_SIZE_MB=50
# MVP: pdf,md,txt / 完整: pdf,docx,md,txt,html
DOC_ALLOWED_EXTENSIONS=pdf,md,txt
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
INGEST_MAX_RETRIES=3
INGEST_TASK_TTL_SECONDS=86400


# -----------------------------------------------------------------------------
# 八、服务与观测
# -----------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# 可选：OpenTelemetry 导出端点
OTEL_EXPORTER_OTLP_ENDPOINT=
# 可选：LangSmith Trace
LANGSMITH_API_KEY=


# -----------------------------------------------------------------------------
# 九、TEI —— 本地 Embedding 服务（可选，默认不启动）
# -----------------------------------------------------------------------------
# 启用方式：docker compose --profile local-emb up -d
#
# ============================== ⚠️ 必读警告 ==============================
#  TEI 默认模型 BAAI/bge-m3 的 dense 向量维度是 1024，
#  而上面第五节锁定的 text-embedding-3-small 是 1536 维。
#  二者【禁止】写入同一个 Qdrant Collection，否则检索会直接报错。
#
#  启用 TEI 时，必须同时修改以下【三处】配置：
#      1. EMBEDDING_BASE_URL=http://localhost:8080/v1   ← 只改这个，不要动 OPENAI_BASE_URL
#      2. EMBEDDING_MODEL=BAAI/bge-m3
#      3. EMBEDDING_DIM=1024                            ← 替换第五节的 1536
#      4. QDRANT_COLLECTION=document_chunks_bgem3       ← 替换第三节的 document_chunks，
#                                                         使用一个全新的 Collection 名
#
#  ⚠️ 切勿把 OPENAI_BASE_URL 或 LLM_BASE_URL 指向 TEI：
#     TEI 只实现 /v1/embeddings，没有 /v1/chat/completions，
#     一旦指向它，所有大模型调用（问题规划 / 证据分析 / 充分性判断 / 生成答案）都会失败。
#
#  维度变更的完整迁移流程见 prd/04-data-model.md §6.3。
# ===========================================================================
TEI_PORT=8080
TEI_MODEL_ID=BAAI/bge-m3
# 单批最大 token 数，内存不足时可下调
TEI_MAX_BATCH_TOKENS=16384
